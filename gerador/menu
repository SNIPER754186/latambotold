# --- Función para Mostrar Puertos Activos y Servicios ---
mine_port () {
local portasVAR=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" |grep -v "COMMAND" | grep "LISTEN")
local NOREPEAT
local reQ
local Port
while read port; do
reQ=$(echo "${port}"|awk '{print $1}')
Port=$(echo "${port}" | awk '{print $9}' | awk -F ":" '{print $2}')
[[ $(echo -e "$NOREPEAT"|grep -w "$Port") ]] && continue # Evita puertos duplicados.
NOREPEAT+="$Port\n" # Añade el puerto a la lista de no repetidos.

# Clasifica los puertos por servicio.
case "${reQ}" in
squid|squid3)
[[ -z $SQD ]] && local SQD="\033[1;31mSQUID: \033[1;32m"
SQD+="$Port ";;
apache|apache2)
[[ -z $APC ]] && local APC="\033[1;31mAPACHE: \033[1;32m"
APC+="$Port ";;
ssh|sshd)
[[ -z $SSH ]] && local SSH="\033[1;31mSSH: \033[1;32m"
SSH+="$Port ";;
dropbear)
[[ -z $DPB ]] && local DPB="\033[1;31mDROPBEAR: \033[1;32m"
DPB+="$Port ";;
openvpn)
[[ -z $OVPN ]] && local OVPN="\033[1;31mOPENVPN: \033[1;32m"
OVPN+="$Port ";;
python|python3) # Socks Python
[[ -z $PY3 ]] && local PY3="\033[1;31mSOCKS: \033[1;32m"
PY3+="$Port ";;
stunnel4|stunnel) # SSL
[[ -z $SSL ]] && local SSL="\033[1;31mSSL: \033[1;32m"
SSL+="$Port ";;
esac
done <<< "${portasVAR}"
# Imprime los puertos clasificados.
[[ ! -z $SQD ]] && echo -e "$SQD"
[[ ! -z $APC ]] && echo -e "$APC"
[[ ! -z $SSH ]] && echo -e "$SSH"
[[ ! -z $DPB ]] && echo -e "$DPB"
[[ ! -z $OVPN ]] && echo -e "$OVPN"
[[ ! -z $PY3 ]] && echo -e "$PY3"
[[ ! -z $SSL ]] && echo -e "$SSL"
}

# --- Función de Ofuscación (duplicada) ---
# Esta es una copia de la función 'ofus' que ya está definida en otros scripts.
# Se mantiene por compatibilidad, pero puede ser refactorizada para una única definición global.
ofus () {
unset txtofus
number=$(expr length "$1")
for((i=1; i<number+1; i++)); do
txt[$i]=$(echo "$1" | cut -b "$i")
case "${txt[$i]}" in
".")txt[$i]="+";; "+")txt[$i]=".";;
"1")txt[$i]="@";; "@")txt[$i]="1";;
"2")txt[$i]="?";; "?")txt[$i]="2";;
"3")txt[$i]="%";; "%")txt[$i]="3";;
"/")txt[$i]="K";; "K")txt[$i]="/";;
esac
txtofus+="${txt[$i]}"
done
echo "$txtofus" | rev
}

