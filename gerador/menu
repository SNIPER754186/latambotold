# --- Menú de Instalación ---
# `pid_inst`: Verifica si un servicio está corriendo y muestra "on" o "off".
pid_inst () {
[[ -z "$1" ]] && echo -e "\033[1;31moff" && return 0 # Si no se da un servicio, es 'off'.
unset portas
# Obtiene todos los puertos en estado LISTEN.
portas_var=$(lsof -V -i tcp -P -n | grep -v "ESTABLISHED" |grep -v "COMMAND" | grep "LISTEN")
i=0
while read port; do
var1=$(echo "$port" | awk '{print $1}') && var2=$(echo "$port" | awk '{print $9}' | awk -F ":" '{print $2}')
[[ "$(echo -e "${portas[@]}"|grep "$var1 $var2")" ]] || { # Evita duplicados.
    portas[$i]="$var1 $var2\n"
    let i++
    }
done <<< "$portas_var"
# Comprueba si el servicio está en la lista de puertos activos.
[[ $(echo "${portas[@]}"|grep "$1") ]] && echo -e "\033[1;32mon" || echo -e "\033[1;31moff"
}

