# --- Función para Agregar Herramientas (desde URL o clave) ---
agregar_ferramenta () {
tput cuu1 && tput dl1
msg -bar2
msg -verm "¡ATENCIÓN!${SEMCOR}" # Traducido
msg -verm "No introduzca una clave de actualización aquí." # Traducido
msg -bra "Ingrese la Clave o el Enlace Directo para el Nuevo Recurso:" # Traducido
msg -bar2
unset Key
while [[ -z "$Key" ]]; do
echo -ne "[Clave/Enlace]: " && read Key # Traducido.
tput cuu1 && tput dl1
done
echo -ne "\033[1;37mVerificando recurso: ${SEMCOR}" # Traducido.
cd "${SCPfrm}"
curl "$Key" &> /dev/null # Intenta descargar como URL directa.
if [[ $? = "0" ]]; then # Si la descarga directa fue exitosa...
echo -e "\033[1;32m ¡Enlace Válido!${SEMCOR}" # Traducido.
REC=$(echo "$Key"|awk -F"/" '{print $NF}') # Obtiene el nombre del archivo de la URL.
echo -ne "\033[1;33mRecibiendo Recurso: \033[1;31m[$REC] " # Traducido.
wget -O "${SCPfrm}/${REC}" "$Key" &>/dev/null && \
echo -e "\033[1;31m- \033[1;32m¡Recibido!${SEMCOR}" && chmod +x "${SCPfrm}/${REC}" || \
echo -e "\033[1;31m- \033[1;31m¡Error al Recibir!${SEMCOR}" # Traducido.
else # Si no es un enlace directo, intenta con la función 'ofus' (como clave).
wget "$(ofus "$Key")" >/dev/null 2>&1 && echo -e "\033[1;32m ¡Clave Válida!${SEMCOR}" || {
    msg -verm "¡Clave inválida o enlace no válido!${SEMCOR}" # Traducido.
    msg -bar2
    return 0   
    }
fi
IP=$(ofus "$Key" | grep -vE '127\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}' | grep -o -E '[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}') # Obtiene la IP del servidor de la clave.
sleep 1s
[[ -e "${SCPfrm}/lista-arq" ]] && { # Si se descargó una lista de archivos (desde una clave)...
  if [[ $(cat "${SCPfrm}/lista-arq") = "KEY DE INSTALACION!" ]]; then # Si es una clave de instalación...
  echo -e "\033[1;33m¡CLAVE DE INSTALACIÓN NO DEBE SER USADA AQUÍ!${SEMCOR}" # Traducido.
  msg -bar2
  rm "${SCPfrm}/lista-arq"
  return 1
  fi
  if [[ $(cat "${SCPfrm}/lista-arq") = "KEY INVALIDA!" ]]; then # Si la clave es inválida...
  echo -e "\033[1;33m¡CLAVE INVÁLIDA!${SEMCOR}" # Traducido.
  msg -bar2
  rm "${SCPfrm}/lista-arq"
  return 1
  fi
  REQUEST=$(ofus "$Key" |cut -d'/' -f2) # Extrae el request de la clave.
  for arqx in $(cat "${SCPfrm}/lista-arq"); do
  echo -ne "\033[1;33mRecibiendo Recurso: \033[1;31m[$arqx] " # Traducido.
  wget -O "${SCPfrm}/${arqx}" "${IP}:81/${REQUEST}/${arqx}" > /dev/null 2>&1 && \
  echo -e "\033[1;31m- \033[1;32m¡Recibido!${SEMCOR}" && chmod +x "${SCPfrm}/${arqx}" || \
  echo -e "\033[1;31m- \033[1;31m¡Error al Recibir!${SEMCOR}" # Traducido.
  sleep 1s
  done
  rm "${SCPfrm}/lista-arq" # Elimina la lista temporal.
  msg -bar2
  } 
}

# --- Función para Limpiar la Caché del Sistema ---
limpar_caches () {
(
VE="\033[1;33m" && MA="\033[1;31m" && DE="\033[1;32m" # Colores temporales.
# Animación de progreso.
while [[ ! -e /tmp/abc ]]; do
A+="#"
echo -e "${VE}[${MA}${A}${VE}]" >&2
sleep 0.3s
tput cuu1 && tput dl1
done
echo -e "${VE}[${MA}${A}${VE}] - ${DE}[100%]" >&2
rm /tmp/abc
) & # Ejecuta la animación en segundo plano.
echo 3 > /proc/sys/vm/drop_caches &>/dev/null # Limpia la caché de página.
sleep 1s
sysctl -w vm.drop_caches=3 &>/dev/null # Método alternativo para limpiar caché.
apt-get autoclean -y &>/dev/null # Limpia paquetes de APT.
sleep 1s
apt-get clean -y &>/dev/null # Limpia caché de APT.
rm /tmp/* &>/dev/null # Elimina archivos temporales.
touch /tmp/abc # Crea el archivo de bandera para detener la animación.
sleep 0.5s
msg -bar
msg -ama "¡PROCESO CONCLUIDO!${SEMCOR}" # Traducido.
msg -bar
}

# --- Función para Activar/Desactivar el Auto-Inicio del Menú ---
fun_autorun () {
if [[ -e /etc/bash.bashrc-bakup ]]; then # Si existe un backup, significa que el auto-inicio está activo.
mv -f /etc/bash.bashrc-bakup /etc/bash.bashrc # Restaura el .bashrc original.
# Elimina la línea de auto-inicio del menú si existe.
cat /etc/bash.bashrc | grep -v "/etc/newadm/menu" > /tmp/bash
mv -f /tmp/bash /etc/bash.bashrc
msg -ama "¡AUTO-INICIO REMOVIDO CON ÉXITO!${SEMCOR}" # Traducido.
msg -bar
elif [[ -e /etc/bash.bashrc ]]; then # Si no hay backup, significa que está desactivado.
cat /etc/bash.bashrc|grep -v /bin/adm > /etc/bash.bashrc.2 # Elimina líneas de /bin/adm.
echo '/etc/newadm/menu' >> /etc/bash.bashrc.2 # Añade la línea para auto-iniciar el menú.
cp /etc/bash.bashrc /etc/bash.bashrc-bakup # Crea un backup del .bashrc original.
mv -f /etc/bash.bashrc.2 /etc/bash.bashrc # Reemplaza el .bashrc.
msg -ama "¡AUTO-INICIO AÑADIDO CON ÉXITO!${SEMCOR}" # Traducido.
msg -bar
fi
}

# --- Función de Barra de Progreso (genérica) ---
# Muestra una barra de progreso mientras se ejecuta un comando en segundo plano.
fun_bar () {
comando="$1"
 _=$(
"$comando" > /dev/null 2>&1
) & > /dev/null
pid=$!
while [[ -d /proc/$pid ]]; do
echo -ne " \033[1;33m["
   for((i=0; i<10; i++)); do
   echo -ne "\033[1;31m##"
   sleep 0.2
   done
echo -ne "\033[1;33m]"
sleep 1s
echo
tput cuu1
tput dl1
done
echo -e " \033[1;33m[\033[1;31m####################\033[1;33m] - \033[1;32m100%${SEMCOR}" # Traducido.
sleep 1s
}

