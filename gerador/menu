}

# --- Función para Traducción (usando un script Python) ---
# Esta función es crucial para la internacionalización del script.
# Asume que el script 'trans' ya está instalado y configurado para traducir.
# Si el idioma del usuario es el mismo que el de origen (PT por defecto), no traduce.
fun_trans () {
local source="pt" # Idioma de origen de los textos originales del script.
SCPidioma="${SCPdir}/idioma" # Ruta del archivo de idioma del usuario.
[[ ! -e "${SCPidioma}" ]] && touch "${SCPidioma}" # Asegura que el archivo de idioma exista.
local LINGUAGE=$(cat "${SCPidioma}") # Lee el idioma configurado por el usuario.
[[ -z "$LINGUAGE" ]] && LINGUAGE="pt" # Si no hay idioma, usa portugués como fallback.

# Si el idioma actual es el mismo que la fuente, no se necesita traducir.
# Para este script, como todo está siendo traducido al español, esta función
# en la mayoría de los casos devolverá el texto sin cambios, a menos que
# el usuario cambie el idioma del menú a otro diferente del español.
[[ "$LINGUAGE" = "pt" ]] && echo "$@" && return

# Determina la ruta del intérprete de Python 3.
if [[ -e /usr/bin/python3 ]]; then
PY="/usr/bin/python3"
elif [[ -e /bin/python3 ]]; then
PY="/bin/python3"
else
echo "Error: Python3 no encontrado. Necesario para las traducciones." # Traducido.
exit 1
fi

# Ejecuta un script Python en línea para realizar la traducción.
$PY -x << PYTHON
# -*- coding: latin-1 -*-
import requests, sys

def traduccion(source, target, text):
    data = {'sl': source, 'tl': target, 'q': text}
    headers = {"Charset":"UTF-8","User-Agent":"AndroidTranslate/5.3.0.RC02.130475354-53000263 5.1 phone TRANSLATE_OPM5_TEST_1"}
    url = "https://translate.google.com/translate_a/single?client=at&dt=t&dt=ld&dt=qca&dt=rm&dt=bd&dj=1&hl=es-ES&ie=UTF-8&oe=UTF-8&inputm=2&otf=2&iid=1dd3b944-fa62-4b55-b330-74909a99969e"
    try:
        response = requests.post(url, data=data, headers=headers, timeout=5) # Añadido timeout.
        if response.status_code == 200:
            jso=response.json()['sentences']
            for x in jso:
                print (x['trans'])
                return x['trans']
        else:
            print ("Ocurrió un error en la API de traducción: " + str(response.status_code)) # Traducido.
            return "Ocurrió un error" # Traducido.
    except requests.exceptions.RequestException as e:
        print ("Error de conexión para la traducción: " + str(e)) # Traducido.
        return "Ocurrió un error de red" # Traducido.

def main():
    text_to_translate = ' '.join(sys.argv[3:])
    print(traduccion(sys.argv[1], sys.argv[2], text_to_translate))

if __name__ == '__main__':
    main()
PYTHON
}

