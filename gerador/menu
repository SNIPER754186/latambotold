# --- Función para Configurar Ethtool (Mejora de Paquetes SSH) ---
# Permite a usuarios avanzados optimizar el rendimiento de la interfaz de red.
fun_eth () {
eth=$(ifconfig | grep -v inet6 | grep -v lo | grep -v 127.0.0.1 | grep "encap:Ethernet" | awk '{print $1}')
    [[ "$eth" != "" ]] && {
    msg -bar
    msg -ama " ¿Aplicar sistema para mejorar paquetes SSH?${SEMCOR}" # Traducido.
    msg -ama " (Opción para usuarios avanzados)${SEMCOR}" # Traducido.
    msg -bar
    read -p " [S/N]: " -e -i n sshsn # Pregunta al usuario.
           [[ "$sshsn" = @(s|S|y|Y) ]] && { # Si el usuario acepta...
           echo -e "${cor[1]} Corrección de problemas de paquetes en el SSH...${SEMCOR}" # Traducido.
           echo -e " ¿Cuál es la tasa RX (Recepción)?${SEMCOR}" # Traducido.
           echo -ne "[ 1 - 999999999 ]: "; read rx # Pide tasa RX.
           [[ "$rx" = "" ]] && rx="999999999" # Valor por defecto.
           echo -e " ¿Cuál es la tasa TX (Transmisión)?${SEMCOR}" # Traducido.
           echo -ne "[ 1 - 999999999 ]: "; read tx # Pide tasa TX.
           [[ "$tx" = "" ]] && tx="999999999" # Valor por defecto.
           apt-get install ethtool -y > /dev/null 2>&1 # Instala ethtool.
           ethtool -G "$eth" rx "$rx" tx "$tx" > /dev/null 2>&1 # Aplica la configuración.
           }
     msg -bar
     }
}

