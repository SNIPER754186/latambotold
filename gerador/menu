#!/bin/bash

# --- Colores Globales (se pueden personalizar en /etc/new-adm-color) ---
# Se utilizan para estilizar la salida en la terminal.
red=$(tput setaf 1)
gren=$(tput setaf 2)
yellow=$(tput setaf 3)

# --- Variables de Directorio ---
SCPdir="/etc/newadm" # Directorio principal del script.
# Si el directorio principal no existe, el script no puede continuar.
[[ ! -d ${SCPdir} ]] && echo -e "${red}Error: Directorio principal de LatamSRC ADM VPS no encontrado. Saliendo.${SEMCOR}" && exit 1

SCPusr="${SCPdir}/ger-user" # Directorio para scripts de gestión de usuarios.
[[ ! -d ${SCPusr} ]] && mkdir -p ${SCPusr} # Crea si no existe.

SCPfrm="/etc/ger-frm" # Directorio para scripts de herramientas generales.
[[ ! -d ${SCPfrm} ]] && mkdir -p ${SCPfrm} # Crea si no existe.

SCPinst="/etc/ger-inst" # Directorio para scripts de instalación de servicios.
# Originalmente tenía 'SCPfrm' aquí, corregido a 'SCPinst'.
[[ ! -d ${SCPinst} ]] && mkdir -p ${SCPinst} # Crea si no existe.

SCPidioma="${SCPdir}/idioma" # Archivo para almacenar el idioma seleccionado.

# --- Estado de Auto-Inicio del Menú ---
# Determina si el menú se inicia automáticamente con el inicio de sesión del root.
# Verifica si existe un backup de .bashrc (indicando que el auto-inicio está activo).
if [[ -e /etc/bash.bashrc-bakup ]]; then AutoRun="\033[1;32m[activo]" # Traducido
elif [[ -e /etc/bash.bashrc ]]; then AutoRun="\033[1;31m[desactivado]" # Traducido
fi

# --- Funciones Globales para Mensajes ---
# `msg`: Función para mostrar mensajes con colores y barras.
msg () {
local colors="/etc/new-adm-color"
if [[ ! -e $colors ]]; then
# Colores por defecto si no hay archivo de configuración.
COLOR[0]='\033[1;37m' # Blanco
COLOR[1]='\e[31m' # Rojo
COLOR[2]='\e[32m' # Verde
COLOR[3]='\e[33m' # Amarillo
COLOR[4]='\e[34m' # Azul
COLOR[5]='\e[35m' # Magenta
COLOR[6]='\033[1;36m' # Cian
else
# Lee la configuración de colores del archivo.
local COL=0
for number in $(cat "$colors"); do
case "$number" in
1)COLOR[$COL]='\033[1;37m';; # Blanco
2)COLOR[$COL]='\e[31m';; # Rojo
3)COLOR[$COL]='\e[32m';; # Verde
4)COLOR[$COL]='\e[33m';; # Amarillo
5)COLOR[$COL]='\e[34m';; # Azul
6)COLOR[$COL]='\e[35m';; # Magenta
7)COLOR[$COL]='\033[1;36m';; # Cian
esac
let COL++
done
fi
NEGRITO='\e[1m' # Negrita
SEMCOR='\e[0m' # Restablecer color

# Define el formato del mensaje según el primer argumento.
 case "$1" in
  -ne)cor="${COLOR[1]}${NEGRITO}" && echo -ne "${cor}${2}${SEMCOR}";;
  -ama)cor="${COLOR[3]}${NEGRITO}" && echo -e "${cor}${2}${SEMCOR}";;
  -verm)cor="${COLOR[3]}${NEGRITO}[!] ${COLOR[1]}" && echo -e "${cor}${2}${SEMCOR}";; # Exclamación en amarillo, texto en rojo.
  -verm2)cor="${COLOR[1]}${NEGRITO}" && echo -e "${cor}${2}${SEMCOR}";; # Texto en rojo negrita.
  -azu)cor="${COLOR[6]}${NEGRITO}" && echo -e "${cor}${2}${SEMCOR}";; # Texto en cian negrita.
  -verd)cor="${COLOR[2]}${NEGRITO}" && echo -e "${cor}${2}${SEMCOR}";; # Texto en verde negrita.
  -bra)cor="${COLOR[0]}${NEGRITO}" && echo -e "${cor}${2}${SEMCOR}";; # Texto en blanco negrita.
  "-bar2"|"-bar")cor="${COLOR[4]}======================================================" && echo -e "${SEMCOR}${cor}${SEMCOR}";; # Barra azul.
 esac
}

# --- Función para Cambiar los Colores de la Interfaz ---
# Permite al usuario personalizar los 7 colores utilizados en el menú.
canbio_color () {
